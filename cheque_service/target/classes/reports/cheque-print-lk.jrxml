            <textField isBlankWhenNull="true">
                <reportElement x="55" y="145" width="247" height="16"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{amountWordsLine3}]]></textFieldExpression>
            </textField>

            <!-- Amount in numbers -->
            <textField isBlankWhenNull="true">
                <reportElement x="343" y="114" width="138" height="18"/>
                <textElement textAlignment="Right">
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{amountNumber}]]></textFieldExpression>
