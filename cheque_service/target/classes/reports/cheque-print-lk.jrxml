<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="cheque_print_lk"
              pageWidth="332"
              pageHeight="252"
              columnWidth="332"
              leftMargin="0"
              rightMargin="0"
              topMargin="0"
              bottomMargin="0"
              uuid="26cda9fc-63e8-4d80-b0f3-f24f98fd1227">

    <parameter name="dateDay" class="java.lang.String"/>
    <parameter name="dateMonth" class="java.lang.String"/>
    <parameter name="dateYear" class="java.lang.String"/>
    <parameter name="customerName" class="java.lang.String"/>
    <parameter name="amountNumber" class="java.lang.String"/>
    <parameter name="amountWordsLine1" class="java.lang.String"/>
    <parameter name="amountWordsLine2" class="java.lang.String"/>
    <parameter name="amountWordsLine3" class="java.lang.String"/>

    <title>
        <band height="220">

            <!-- Date digits -->
            <textField isBlankWhenNull="true">
                <reportElement x="350" y="28" width="14" height="18"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{dateDay} != null && $P{dateDay}.length() > 0 ? $P{dateDay}.substring(0,1) : ""]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="368" y="28" width="14" height="18"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{dateDay} != null && $P{dateDay}.length() > 1 ? $P{dateDay}.substring(1,2) : ""]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="386" y="28" width="14" height="18"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{dateMonth} != null && $P{dateMonth}.length() > 0 ? $P{dateMonth}.substring(0,1) : ""]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="404" y="28" width="14" height="18"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{dateMonth} != null && $P{dateMonth}.length() > 1 ? $P{dateMonth}.substring(1,2) : ""]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="421" y="28" width="14" height="18"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{dateYear} != null && $P{dateYear}.length() > 0 ? $P{dateYear}.substring(0,1) : ""]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="439" y="28" width="14" height="18"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{dateYear} != null && $P{dateYear}.length() > 1 ? $P{dateYear}.substring(1,2) : ""]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="457" y="28" width="14" height="18"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{dateYear} != null && $P{dateYear}.length() > 2 ? $P{dateYear}.substring(2,3) : ""]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="474" y="28" width="14" height="18"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{dateYear} != null && $P{dateYear}.length() > 3 ? $P{dateYear}.substring(3,4) : ""]]></textFieldExpression>
            </textField>

            <!-- Customer name -->
            <textField isBlankWhenNull="true">
                <reportElement x="43" y="71" width="280" height="20"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{customerName}]]></textFieldExpression>
            </textField>

            <!-- Amount in words lines -->
            <textField isBlankWhenNull="true">
                <reportElement x="55" y="100" width="247" height="16"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{amountWordsLine1}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="55" y="118" width="247" height="16"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{amountWordsLine2}]]></textFieldExpression>
