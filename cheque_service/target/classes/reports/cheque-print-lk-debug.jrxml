<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="cheque_print_lk_debug"
              pageWidth="502"
              pageHeight="252"
              columnWidth="502"
              leftMargin="0"
              rightMargin="0"
              topMargin="0"
              bottomMargin="0"
              uuid="3f9f37b2-fcf8-4662-a1c8-42870e9c6241">

    <parameter name="dateDay" class="java.lang.String"/>
    <parameter name="dateMonth" class="java.lang.String"/>
    <parameter name="dateYear" class="java.lang.String"/>
    <parameter name="customerName" class="java.lang.String"/>
    <parameter name="amountNumber" class="java.lang.String"/>
    <parameter name="amountWordsLine1" class="java.lang.String"/>
    <parameter name="amountWordsLine2" class="java.lang.String"/>
    <parameter name="amountWordsLine3" class="java.lang.String"/>

    <!-- Optional debug params -->
    <parameter name="chequeScanPath" class="java.lang.String"/>
    <parameter name="showGuides" class="java.lang.Boolean">
        <defaultValueExpression><![CDATA[Boolean.TRUE]]></defaultValueExpression>
    </parameter>

    <title>
        <band height="252">

            <!-- Optional cheque scan image background -->
            <image onErrorType="Blank" scaleImage="FillFrame">
                <reportElement x="0" y="0" width="502" height="252"/>
                <imageExpression><![CDATA[$P{chequeScanPath} != null && $P{chequeScanPath}.trim().length() > 0 ? $P{chequeScanPath} : null]]></imageExpression>
            </image>

            <!-- Calibration guides -->
            <frame>
                <reportElement x="0" y="0" width="502" height="252" forecolor="#CC0000">
                    <printWhenExpression><![CDATA[$P{showGuides} == null || $P{showGuides}]]></printWhenExpression>
                </reportElement>

                <rectangle>
                    <reportElement x="0" y="0" width="501" height="251" forecolor="#CC0000"/>
                    <graphicElement>
                        <pen lineWidth="0.5"/>
                    </graphicElement>
                </rectangle>

                <!-- Key baseline guides -->
                <line>
                    <reportElement x="0" y="26" width="502" height="1" forecolor="#CC0000"/>
                    <graphicElement><pen lineWidth="0.4"/></graphicElement>
                </line>
                <line>
                    <reportElement x="0" y="60" width="502" height="1" forecolor="#CC0000"/>
                    <graphicElement><pen lineWidth="0.4"/></graphicElement>
                </line>
                <line>
                    <reportElement x="0" y="89" width="502" height="1" forecolor="#CC0000"/>
                    <graphicElement><pen lineWidth="0.4"/></graphicElement>
                </line>
                <line>
                    <reportElement x="0" y="118" width="502" height="1" forecolor="#CC0000"/>
                    <graphicElement><pen lineWidth="0.4"/></graphicElement>
                </line>
                <line>
                    <reportElement x="0" y="145" width="502" height="1" forecolor="#CC0000"/>
                    <graphicElement><pen lineWidth="0.4"/></graphicElement>
                </line>

                <!-- Date box guides -->
                <line><reportElement x="336" y="0" width="1" height="252" forecolor="#CC0000"/><graphicElement><pen lineWidth="0.4"/></graphicElement></line>
                <line><reportElement x="352" y="0" width="1" height="252" forecolor="#CC0000"/><graphicElement><pen lineWidth="0.4"/></graphicElement></line>
                <line><reportElement x="372" y="0" width="1" height="252" forecolor="#CC0000"/><graphicElement><pen lineWidth="0.4"/></graphicElement></line>
                <line><reportElement x="392" y="0" width="1" height="252" forecolor="#CC0000"/><graphicElement><pen lineWidth="0.4"/></graphicElement></line>
                <line><reportElement x="410" y="0" width="1" height="252" forecolor="#CC0000"/><graphicElement><pen lineWidth="0.4"/></graphicElement></line>
                <line><reportElement x="427" y="0" width="1" height="252" forecolor="#CC0000"/><graphicElement><pen lineWidth="0.4"/></graphicElement></line>
                <line><reportElement x="445" y="0" width="1" height="252" forecolor="#CC0000"/><graphicElement><pen lineWidth="0.4"/></graphicElement></line>
                <line><reportElement x="463" y="0" width="1" height="252" forecolor="#CC0000"/><graphicElement><pen lineWidth="0.4"/></graphicElement></line>
                <line><reportElement x="477" y="0" width="1" height="252" forecolor="#CC0000"/><graphicElement><pen lineWidth="0.4"/></graphicElement></line>

                <!-- Amount number box guide -->
                <rectangle>
                    <reportElement x="343" y="114" width="138" height="18" forecolor="#CC0000"/>
                    <graphicElement><pen lineWidth="0.5"/></graphicElement>
                </rectangle>

                <!-- Labels -->
                <staticText>
                    <reportElement x="4" y="4" width="220" height="10" forecolor="#CC0000"/>
                    <textElement><font size="7" isBold="true"/></textElement>
                    <text><![CDATA[DEBUG GRID: 177mm x 89mm (page 502 x 252)]]></text>
                </staticText>
                <staticText>
                    <reportElement x="4" y="16" width="220" height="10" forecolor="#CC0000"/>
                    <textElement><font size="7"/></textElement>
                    <text><![CDATA[Y=26 Date | Y=60 Payee | Y=89/118/145 Words]]></text>
                </staticText>
            </frame>

            <!-- Date digits -->
            <textField isBlankWhenNull="true">
                <reportElement x="336" y="26" width="14" height="18"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{dateDay} != null && $P{dateDay}.length() > 0 ? $P{dateDay}.substring(0,1) : ""]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="352" y="26" width="14" height="18"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{dateDay} != null && $P{dateDay}.length() > 1 ? $P{dateDay}.substring(1,2) : ""]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="372" y="26" width="14" height="18"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{dateMonth} != null && $P{dateMonth}.length() > 0 ? $P{dateMonth}.substring(0,1) : ""]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="392" y="26" width="14" height="18"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{dateMonth} != null && $P{dateMonth}.length() > 1 ? $P{dateMonth}.substring(1,2) : ""]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="410" y="26" width="14" height="18"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{dateYear} != null && $P{dateYear}.length() > 0 ? $P{dateYear}.substring(0,1) : ""]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="427" y="26" width="14" height="18"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{dateYear} != null && $P{dateYear}.length() > 1 ? $P{dateYear}.substring(1,2) : ""]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="445" y="26" width="14" height="18"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{dateYear} != null && $P{dateYear}.length() > 2 ? $P{dateYear}.substring(2,3) : ""]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="463" y="26" width="14" height="18"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{dateYear} != null && $P{dateYear}.length() > 3 ? $P{dateYear}.substring(3,4) : ""]]></textFieldExpression>
            </textField>

            <!-- Customer name -->
            <textField isBlankWhenNull="true">
                <reportElement x="43" y="60" width="280" height="20"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{customerName}]]></textFieldExpression>
            </textField>

            <!-- Amount in words lines -->
            <textField isBlankWhenNull="true">
                <reportElement x="55" y="89" width="247" height="16"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{amountWordsLine1}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="55" y="118" width="247" height="16"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{amountWordsLine2}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="55" y="145" width="247" height="16"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{amountWordsLine3}]]></textFieldExpression>
            </textField>

            <!-- Amount in numbers -->
            <textField isBlankWhenNull="true" textAdjust="ScaleFont">
                <reportElement x="343" y="114" width="138" height="18"/>
                <textElement textAlignment="Center">
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{amountNumber}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <detail>
        <band height="1"/>
    </detail>
</jasperReport>
