@startuml
title 02e - Auth Change Password (Logged User)
autonumber

actor "Frontend / Postman" as FE
participant "Gateway :8099" as GW
participant "Auth Service :8091" as AUTH
database "Auth DB" as ADB

FE -> GW: POST /api/v1/auth/change-password\nAuthorization Bearer
GW -> AUTH: Forward

AUTH -> AUTH: Resolve authenticated username
AUTH -> AUTH: Validate request fields
AUTH -> AUTH: Validate newPassword == confirmPassword

AUTH -> ADB: Find user by authenticated username
ADB --> AUTH: user

AUTH -> AUTH: Validate currentPassword matches

alt currentPassword valid
  AUTH -> ADB: Save new encoded password + expiry metadata
  AUTH -> ADB: Delete refresh tokens for user
  AUTH --> GW: Success
  GW --> FE: 200 Success
else invalid currentPassword
  AUTH --> GW: 401/400
  GW --> FE: Error
end

@enduml

