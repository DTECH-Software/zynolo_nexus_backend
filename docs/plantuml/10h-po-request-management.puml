@startuml
title 10h - PO Request Management (PORM)
autonumber

actor "Frontend / Postman" as FE
participant "Gateway :8099" as GW
participant "PO Service :8094" as PO
database "PO DB" as PDB
participant "Auth Service :8091" as AUTH

group Reference + Filter + View
  FE -> GW: POST /api/v1/po/request-management/reference-data
  FE -> GW: POST /api/v1/po/request-management/filter-list
  FE -> GW: POST /api/v1/po/request-management/view
  GW -> PO: Forward
  PO -> PDB: Search request lifecycle by requestNo / vendor / company / status
  PO -> AUTH: Load PORM privileges
  PO --> FE: inquiry grid + request details
end

@enduml
