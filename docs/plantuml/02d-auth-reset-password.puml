@startuml
title 02d - Auth Reset Password
autonumber

actor "Frontend / Postman" as FE
participant "Gateway :8099" as GW
participant "Auth Service :8091" as AUTH
database "Auth DB" as ADB

FE -> GW: POST /api/v1/auth/reset-password\n{username, resetToken, newPassword, confirmPassword}
GW -> AUTH: Forward (public endpoint)

AUTH -> AUTH: Validate request fields
AUTH -> AUTH: Validate newPassword == confirmPassword
AUTH -> ADB: Find latest unused token by\nusername + resetToken
ADB --> AUTH: token or empty

alt token exists + otpVerified + not expired
  AUTH -> ADB: Find user by username
  AUTH -> ADB: Update encoded password + expiry metadata
  AUTH -> ADB: Mark reset token as used
  AUTH -> ADB: Delete refresh tokens for user
  AUTH --> GW: Success
  GW --> FE: 200 Success
else invalid token state
  AUTH --> GW: 400 invalid
  GW --> FE: Error
end

@enduml

