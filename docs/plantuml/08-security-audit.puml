@startuml
title 08 - Security and Audit Cross-Cutting Flow
autonumber

actor "Frontend / Postman" as FE
participant "Gateway :8099" as GW
participant "GatewaySecurityFilter" as GSF
participant "Auth Service" as AUTH
participant "Setting Service" as SET
participant "AuditLogFilter (Auth)" as ALA
participant "AuditLogFilter (Setting)" as ALS
database "Auth AuditLog Table" as AAL
database "Setting AuditLog Table" as SAL

group JWT and Routing
  FE -> GW: POST protected endpoint + Bearer token
  GW -> GSF: Validate token
  alt Missing/invalid token
    GSF --> FE: 401 Unauthorized
  else Valid token
    GSF -> GSF: Extract companyId claim\ninject X-Company-Id
    opt Audit-style payload has username + channel/ip/message/userAgent
      GSF -> GSF: Validate payload username vs token subject
      alt mismatch
        GSF --> FE: 403 Invalid username
      end
    end
    alt /api/v1/auth/**
      GW -> AUTH: Forward
    else /api/v1/setting/**
      GW -> SET: Forward
    end
  end
end

group Service Audit Logging (POST endpoints)
  AUTH -> ALA: Capture endpoint + payload + principal
  ALA -> AAL: Save audit row\n(username, channel, ip, userAgent,\nmessage, endpoint, event)

  SET -> ALS: Capture endpoint + payload + principal
  ALS -> SAL: Save audit row\n(username, channel, ip, userAgent,\nmessage, endpoint, event)
end

group CORS Behavior (Browser)
  FE -> GW: Browser request from UI origin
  GW -> FE: CORS headers
  note right
  If duplicated Access-Control-Allow-Origin is returned,
  browser blocks response even if backend returns 200.
  end note
end

@enduml

