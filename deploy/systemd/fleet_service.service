[Unit]
Description=Zynolo Nexus Fleet Service
After=network.target

[Service]
User=dtech
WorkingDirectory=/opt/zynolo_nexus_backend/fleet_service
ExecStart=/usr/bin/java -jar /opt/zynolo_nexus_backend/fleet_service/fleet_service.jar
SuccessExitStatus=143
Restart=always
RestartSec=5
Environment=SPRING_PROFILES_ACTIVE=dev

[Install]
WantedBy=multi-user.target
